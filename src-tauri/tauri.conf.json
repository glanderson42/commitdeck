{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CommitDeck",
  "version": "0.1.0-beta.1",
  "identifier": "com.commitdeck.app",
  "build": {
    "beforeDevCommand": "npm run build:core && npm run dev:desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:core && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CommitDeck",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#101214"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/commitdeck-core"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
